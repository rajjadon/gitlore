# Everything the published extension does not need. esbuild bundles `src/` and every runtime
# dependency into `out/extension.js`, so the shipped package is that one file plus `media/`.
#
# Verify with `npx vsce ls` before publishing: the file list should be ~15 entries, not thousands.

# Bundled into out/extension.js already — shipping these too added 5298 files and 4 MB.
node_modules/**

# Sources and build tooling
src/**
test/**
out-test/**
scripts/**
esbuild.js
eslint.config.js
tsconfig.json
**/*.map

# Repo-internal, not for users. CLAUDE.md and AGENTS.md are the project's own working instructions
# for AI coding assistants (AGENTS.md is the same document for assistants that read that name).
CLAUDE.md
AGENTS.md
.github/**
.vscode/**
.claude/**
.gitignore
.vscodeignore

# Dev-process tooling: the code-review-graph index, subagent-driven-development scratch/ledgers,
# and the spec/plan docs those processes produce. None of this is user-facing.
.code-review-graph/**
.superpowers/**
docs/**

# The icon source; package.json points at the rendered PNG.
media/icon.svg

# README screenshots are served to the Marketplace over HTTPS from GitHub (relative paths don't
# resolve on the extension page), so shipping copies in the package is pure weight.
media/screenshots/**

**/.git/**
.DS_Store
