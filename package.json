{
  "name": "gitlore",
  "displayName": "GitLore — git blame, history & commit graph",
  "description": "The story behind every line. Free, local-first git blame, history, commit graph and branch comparison — no account, no telemetry.",
  "version": "1.2.4",
  "publisher": "RajpratapsinghJadon",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitLore.toggleBlame",
        "title": "GitLore: Toggle Inline Blame",
        "icon": "$(eye)"
      },
      {
        "command": "gitLore.showFileHistory",
        "title": "GitLore: Show File History",
        "icon": "$(history)"
      },
      {
        "command": "gitLore.loadMoreFileHistory",
        "title": "GitLore: Load More File History",
        "icon": "$(ellipsis)"
      },
      {
        "command": "gitLore.copySha",
        "title": "GitLore: Copy Commit SHA",
        "icon": "$(copy)"
      },
      {
        "command": "gitLore.showCommit",
        "title": "GitLore: Show Commit Details",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitLore.showPullRequest",
        "title": "GitLore: Show Pull Request Details",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "gitLore.openGraph",
        "title": "GitLore: Open Commit Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gitLore.showVisualFileHistory",
        "title": "GitLore: Show Visual File History",
        "icon": "$(graph-line)"
      },
      {
        "command": "gitLore.compareBranches",
        "title": "GitLore: Compare Branches",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitLore.explainCommit",
        "title": "GitLore: Explain Commit with AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitLore.explainPullRequest",
        "title": "GitLore: Explain Pull Request with AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitLore.summarizeBranchComparison",
        "title": "GitLore: Summarize Branch Comparison with AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitLore.draftPrReview",
        "title": "GitLore: Draft PR Review Comment with AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitLore.generateCommitMessage",
        "title": "GitLore: Generate Commit Message with AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitLore.explainLine",
        "title": "GitLore: Explain This Line's History",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitLore.showFileOwnership",
        "title": "GitLore: Show File Ownership",
        "icon": "$(person)"
      },
      {
        "command": "gitLore.rebaseInteractively",
        "title": "GitLore: Rebase Branch Interactively...",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitLore.checkoutBranch",
        "title": "GitLore: Checkout Branch",
        "icon": "$(check)"
      },
      {
        "command": "gitLore.compareBranchFromExplorer",
        "title": "GitLore: Compare with Current Branch",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitLore.mergeBranchFromExplorer",
        "title": "GitLore: Merge into Current Branch",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitLore.rebaseOntoBranchFromExplorer",
        "title": "GitLore: Rebase Current Branch onto This",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitLore.openRemote",
        "title": "GitLore: Open Remote in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "gitLore.applyStash",
        "title": "GitLore: Apply Stash",
        "icon": "$(check)"
      },
      {
        "command": "gitLore.dropStash",
        "title": "GitLore: Drop Stash",
        "icon": "$(trash)"
      },
      {
        "command": "gitLore.renameBranchFromExplorer",
        "title": "GitLore: Rename Branch",
        "icon": "$(edit)"
      },
      {
        "command": "gitLore.deleteBranchFromExplorer",
        "title": "GitLore: Delete Branch",
        "icon": "$(trash)"
      },
      {
        "command": "gitLore.deleteTagFromExplorer",
        "title": "GitLore: Delete Tag",
        "icon": "$(trash)"
      },
      {
        "command": "gitLore.addWorktreeFromExplorer",
        "title": "GitLore: Add Worktree",
        "icon": "$(add)"
      },
      {
        "command": "gitLore.removeWorktreeFromExplorer",
        "title": "GitLore: Remove Worktree",
        "icon": "$(trash)"
      },
      {
        "command": "gitLore.createStashFromExplorer",
        "title": "GitLore: New Stash",
        "icon": "$(add)"
      },
      {
        "command": "gitLore.recoverFromReflog",
        "title": "GitLore: Recover Lost Commit or Branch"
      },
      {
        "command": "gitLore.stepLineHistory",
        "title": "GitLore: Step Through This Line's History",
        "icon": "$(chevron-left)"
      },
      {
        "command": "gitLore.showCoChangedFiles",
        "title": "GitLore: Show Files That Often Change With This One",
        "icon": "$(references)"
      },
      {
        "command": "gitLore.toggleFullFileBlame",
        "title": "GitLore: Toggle Full-File Blame Heatmap",
        "icon": "$(flame)"
      },
      {
        "command": "gitLore.openLaunchpad",
        "title": "GitLore: Open Launchpad",
        "icon": "$(rocket)"
      },
      {
        "command": "gitLore.openChat",
        "title": "GitLore: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "gitLore.askAboutFile",
        "title": "GitLore: Ask GitLore About This File",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "gitLore.askAboutCommit",
        "title": "GitLore: Ask GitLore About This Commit",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "gitLore.askAboutLine",
        "title": "GitLore: Ask GitLore About This Line",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "gitLore.askAboutPullRequest",
        "title": "GitLore: Ask GitLore About This Pull Request",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "gitLore.generateChangelog",
        "title": "GitLore: Generate Changelog with AI",
        "icon": "$(sparkle)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "gitLore",
          "title": "GitLore",
          "icon": "media/panel-icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "gitLoreExplorer",
          "title": "GitLore",
          "icon": "media/panel-icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "gitLore.fileHistory",
          "name": "File History",
          "when": "gitLore.fileHistory.hasContent"
        }
      ],
      "gitLoreExplorer": [
        {
          "id": "gitLore.explorer",
          "name": "Explorer"
        }
      ],
      "gitLore": [
        {
          "type": "webview",
          "id": "gitLore.commitGraph",
          "name": "Commit Graph"
        },
        {
          "type": "webview",
          "id": "gitLore.commitDetails",
          "name": "Commit Details",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "gitLore.branchComparison",
          "name": "Branch Comparison",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "gitLore.visualFileHistory",
          "name": "Visual File History",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "gitLore.pullRequestDetails",
          "name": "Pull Request Details",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "gitLore.chat",
          "name": "Chat",
          "visibility": "collapsed"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "gitLore.rebaseEditor",
        "displayName": "GitLore Interactive Rebase",
        "selector": [
          {
            "filenamePattern": "**/{rebase-merge,rebase-apply}/git-rebase-todo"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "gitLore.copySha",
          "when": "view == gitLore.fileHistory && viewItem == gitLore.commit"
        },
        {
          "command": "gitLore.checkoutBranch",
          "when": "view == gitLore.explorer && (viewItem == gitLore.branch || viewItem == gitLore.branch.remote)",
          "group": "inline"
        },
        {
          "command": "gitLore.compareBranchFromExplorer",
          "when": "view == gitLore.explorer && (viewItem == gitLore.branch || viewItem == gitLore.branch.remote)"
        },
        {
          "command": "gitLore.mergeBranchFromExplorer",
          "when": "view == gitLore.explorer && (viewItem == gitLore.branch || viewItem == gitLore.branch.remote)"
        },
        {
          "command": "gitLore.rebaseOntoBranchFromExplorer",
          "when": "view == gitLore.explorer && (viewItem == gitLore.branch || viewItem == gitLore.branch.remote)"
        },
        {
          "command": "gitLore.renameBranchFromExplorer",
          "when": "view == gitLore.explorer && (viewItem == gitLore.branch || viewItem == gitLore.branch.current)"
        },
        {
          "command": "gitLore.deleteBranchFromExplorer",
          "when": "view == gitLore.explorer && viewItem == gitLore.branch"
        },
        {
          "command": "gitLore.openRemote",
          "when": "view == gitLore.explorer && viewItem == gitLore.remote",
          "group": "inline"
        },
        {
          "command": "gitLore.applyStash",
          "when": "view == gitLore.explorer && viewItem == gitLore.stash",
          "group": "inline"
        },
        {
          "command": "gitLore.dropStash",
          "when": "view == gitLore.explorer && viewItem == gitLore.stash"
        },
        {
          "command": "gitLore.deleteTagFromExplorer",
          "when": "view == gitLore.explorer && viewItem == gitLore.tag"
        },
        {
          "command": "gitLore.addWorktreeFromExplorer",
          "when": "view == gitLore.explorer && viewItem == gitLore.section.worktrees",
          "group": "inline"
        },
        {
          "command": "gitLore.removeWorktreeFromExplorer",
          "when": "view == gitLore.explorer && viewItem == gitLore.worktree"
        },
        {
          "command": "gitLore.createStashFromExplorer",
          "when": "view == gitLore.explorer && viewItem == gitLore.section.stashes",
          "group": "inline"
        }
      ],
      "scm/title": [
        {
          "command": "gitLore.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "gitLore.compareBranches",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@1"
        },
        {
          "command": "gitLore.showFileHistory",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@2"
        },
        {
          "command": "gitLore.toggleBlame",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@3"
        },
        {
          "command": "gitLore.openGraph",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@4"
        },
        {
          "command": "gitLore.showVisualFileHistory",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@5"
        },
        {
          "command": "gitLore.openLaunchpad",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@6"
        },
        {
          "command": "gitLore.openChat",
          "when": "view == gitLore.commitGraph",
          "group": "navigation@7"
        },
        {
          "command": "gitLore.askAboutCommit",
          "when": "view == gitLore.commitDetails",
          "group": "navigation@3"
        },
        {
          "command": "gitLore.askAboutPullRequest",
          "when": "view == gitLore.pullRequestDetails",
          "group": "navigation@1"
        },
        {
          "command": "gitLore.compareBranches",
          "when": "view == gitLore.branchComparison",
          "group": "navigation@1"
        },
        {
          "command": "gitLore.toggleBlame",
          "when": "view == gitLore.branchComparison",
          "group": "navigation@2"
        },
        {
          "command": "gitLore.showFileHistory",
          "when": "view == gitLore.commitDetails",
          "group": "navigation@1"
        },
        {
          "command": "gitLore.toggleBlame",
          "when": "view == gitLore.commitDetails",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitLore.copySha",
          "when": "false"
        },
        {
          "command": "gitLore.loadMoreFileHistory",
          "when": "false"
        },
        {
          "command": "gitLore.explainLine",
          "when": "false"
        },
        {
          "command": "gitLore.checkoutBranch",
          "when": "false"
        },
        {
          "command": "gitLore.compareBranchFromExplorer",
          "when": "false"
        },
        {
          "command": "gitLore.mergeBranchFromExplorer",
          "when": "false"
        },
        {
          "command": "gitLore.rebaseOntoBranchFromExplorer",
          "when": "false"
        },
        {
          "command": "gitLore.openRemote",
          "when": "false"
        },
        {
          "command": "gitLore.applyStash",
          "when": "false"
        },
        {
          "command": "gitLore.dropStash",
          "when": "false"
        },
        {
          "command": "gitLore.stepLineHistory",
          "when": "false"
        },
        {
          "command": "gitLore.showCoChangedFiles",
          "when": "false"
        },
        {
          "command": "gitLore.askAboutLine",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "GitLore",
      "properties": {
        "gitLore.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline blame decorations, hover cards, and the status bar item."
        },
        "gitLore.blame.format": {
          "type": "string",
          "default": "{author}, {age}",
          "description": "Template for the inline blame text. Tokens: {author} {age} {date} {message} {sha}"
        },
        "gitLore.blame.highlightCurrentLine": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the current line's blame decoration."
        },
        "gitLore.blame.ignoreWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Pass -w to git blame to ignore whitespace-only changes."
        },
        "gitLore.maxBlameFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "Skip blame for files larger than this size, in bytes."
        },
        "gitLore.maxHistoryItems": {
          "type": "number",
          "default": 200,
          "description": "Max commits loaded per file history."
        },
        "gitLore.maxGraphItems": {
          "type": "number",
          "default": 200,
          "description": "Max commits loaded in the commit graph."
        },
        "gitLore.staleCode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a CodeLens above functions and methods that haven't changed in longer than staleThresholdDays."
        },
        "gitLore.staleThresholdDays": {
          "type": "number",
          "default": 180,
          "description": "Days since a function's or method's last change before it's flagged as stale."
        },
        "gitLore.coChange.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a CodeLens above the file for other files that frequently change alongside it (a 'logical coupling' signal from git history)."
        },
        "gitLore.ownership.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a color mark per line in the editor's overview ruler for that line's author. A more opinionated visual than inline blame, so it's off by default."
        },
        "gitLore.fullFileBlame.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a hot-to-cold recency gradient as a left-edge mark per line, across the whole file. A more opinionated visual than inline blame, so it's off by default."
        },
        "gitLore.issueLinking.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Auto-link issue/PR references in commit messages (e.g. #123) in the blame hover and commit details."
        },
        "gitLore.issueLinking.pattern": {
          "type": "string",
          "default": "#(\\d+)",
          "description": "Regex matching issue/PR references in commit messages. The first capture group (or the whole match, if none) fills {issue} in the URL template."
        },
        "gitLore.issueLinking.urlTemplate": {
          "type": "string",
          "default": "",
          "description": "'{issue}'-templated URL for issue links, e.g. https://github.com/owner/repo/issues/{issue}. Leave empty to auto-detect from the repo's git remote (GitHub or GitLab)."
        },
        "gitLore.ai.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI features (commit summaries, line explanations). Uses your own language model via vscode.lm — no key or diff ever leaves your machine unless this is on."
        },
        "gitLore.ai.modelFamily": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Preferred language model family hint (e.g. gpt-4o, claude-3.5-sonnet). Falls back to any available model if no match is found."
        },
        "gitLore.ai.maxDiffChars": {
          "type": "number",
          "default": 8000,
          "description": "Max diff size, in characters, sent to the model for a commit summary. Longer diffs are truncated."
        },
        "gitLore.ai.maxToolIterations": {
          "type": "number",
          "default": 6,
          "description": "Max tool-call round trips GitLore Chat makes per question before it stops and shows whatever answer the model has produced so far."
        },
        "gitLore.rebaseEditor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use GitLore's Interactive Rebase Editor for git-rebase-todo files. When disabled, they open in the default text editor."
        },
        "gitLore.launchpad.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Launchpad, the cross-repo PR triage board. Off by default — it's the only GitLore feature that calls out to a remote host (GitHub, GitLab, Bitbucket, Azure DevOps, or a configured custom instance) rather than working entirely from your local .git."
        },
        "gitLore.launchpad.customHosts": {
          "type": "array",
          "default": [],
          "description": "Self-hosted or custom git-forge instances Launchpad can't recognize by hostname alone (GitHub Enterprise Server, Gitea, Forgejo, self-hosted GitLab, etc). Each entry maps a hostname to which of the four API shapes it speaks and its API base URL.",
          "items": {
            "type": "object",
            "required": [
              "hostname",
              "flavor",
              "apiBaseUrl"
            ],
            "properties": {
              "hostname": {
                "type": "string",
                "description": "The git remote's hostname, e.g. \"github.acme.com\"."
              },
              "flavor": {
                "type": "string",
                "enum": [
                  "github",
                  "gitlab",
                  "bitbucket",
                  "azureDevOps"
                ],
                "description": "Which API shape this host speaks. Gitea/Forgejo are API-compatible with GitHub, so use \"github\" for those."
              },
              "apiBaseUrl": {
                "type": "string",
                "description": "The API base URL, e.g. \"https://github.acme.com/api/v3\" or \"https://gitlab.acme.com/api/v4\"."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint && node esbuild.js --production",
    "compile": "tsc --noEmit -p . && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:integration": "npm run compile && tsc -p . --outDir out-test && node out-test/test/integration/runTests.js",
    "lint": "eslint --no-error-on-unmatched-pattern src test && tsc --noEmit -p .",
    "icon": "rsvg-convert -w 256 -h 256 media/icon.svg -o media/icon.png",
    "shots": "tsx scripts/shoot-screenshots.ts",
    "shots:native": "tsx scripts/shoot-native-screenshots.ts",
    "package": "vsce package",
    "package:pre": "vsce package --pre-release",
    "publish": "vsce publish",
    "publish:pre": "vsce publish --pre-release",
    "publish:ovsx": "ovsx publish",
    "publish:ovsx:pre": "ovsx publish --pre-release"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "diff": "^5.2.2",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.15.0",
    "mocha": "^12.0.0",
    "ovsx": "^0.10.12",
    "playwright": "1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#171B26",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rajjadon/gitlore.git"
  },
  "bugs": {
    "url": "https://github.com/rajjadon/gitlore/issues"
  },
  "homepage": "https://github.com/rajjadon/gitlore#readme",
  "keywords": [
    "git",
    "blame",
    "git history",
    "commit graph",
    "free alternative"
  ]
}
